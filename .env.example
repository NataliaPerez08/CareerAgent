# Strands uses Amazon Bedrock by default.
# Prefer configuring credentials with the AWS CLI instead of storing secrets here.
AWS_REGION=us-east-1
# AWS_PROFILE=default

# Bedrock model settings (read by app/agent.py).
BEDROCK_MODEL_ID=amazon.nova-micro-v1:0
BEDROCK_TEMPERATURE=0.2
# Max output tokens. Nova Micro supports up to 5120; keep it explicit because
# Bedrock's dynamic default truncates long structured responses.
BEDROCK_MAX_TOKENS=5120

# Resume upload settings (read by app/resume_parser.py).
RESUME_MAX_SIZE_MB=5

# Job URL ingestion (read by app/job_ingestion.py).
JOB_FETCH_TIMEOUT_SECONDS=10
JOB_FETCH_MAX_BYTES=2000000
JOB_MIN_DESCRIPTION_CHARS=20

# Persistence (read by app/db.py and app/migrations/env.py).
# Default: local SQLite file. Use PostgreSQL for docker compose / production.
DATABASE_URL=sqlite:///./careeragent.db
# DATABASE_URL=postgresql+psycopg://careeragent:careeragent@localhost:5432/careeragent

# AgentCore deployment tooling (read by scripts/agentcore_deploy.py, deploy only).
# AGENT_NAME=career-agent
# AGENTCORE_ROLE_ARN=arn:aws:iam::123456789012:role/AgentCoreRuntimeRole

# Email report settings (smtplib). Gmail requires an App Password, not your login password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_TO=you@gmail.com
